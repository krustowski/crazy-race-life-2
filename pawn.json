{
	"user": "krustowski",
	"repo": "crazy-race-life-2",
	"tag": "v0.13.0",
	"entry": "src/main.pwn",
	"output": "gamemodes/crl2.amx",
	"dependencies": [
		"openmultiplayer/omp-stdlib"
	],
	"local": true,
	"runtime": {
		"version": "openmp"
	},
	"builds": [
		{
			"name": "main",
			"args": [
				"-d3",
				"-;+",
				"-(+"
			]
		},
		{
			"name": "debug",
			"args": [
				"-d3",
				"-;+",
				"-(+",
				"DEBUG_ENABLED=1"
			]
		}
	]
}
